{
    "server": {
        "host": "0.0.0.0",
        "port": 8000,
        "workers": 4
    },
    "security": {
        "secret_key": "your-secret-key-here",
        "algorithm": "HS256",
        "admin_password_hash": "$2b$12$LQv3c1yqBWVHxkd0LHAkCOYz6TtxMQJqhN8/LewYpwDM.9QpJtUY6",
        "token_expire_minutes": 30
    },
    "data_ingestion": {
        "log_path": "/var/log/security/events.log",
        "api_keys": {
            "otx": "your-otx-api-key",
            "virustotal": "your-virustotal-api-key"
        },
        "scan_interval_minutes": 15
    },
    "risk_scoring": {
        "anomaly_contamination": 0.1,
        "svm_kernel": "rbf",
        "score_weights": {
            "anomaly": 0.4,
            "classifier": 0.6
        },
        "model_paths": {
            "anomaly": "models/anomaly_detector.joblib",
            "classifier": "models/risk_classifier.joblib"
        },
        "feature_importance": {
            "n_features": 10,
            "method": "lime"
        }
    },
    "logging": {
        "level": "INFO",
        "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
        "file": "logs/cybersec_risk.log"
    },
    "database": {
        "url": "postgresql://user:password@localhost:5432/cybersec_risk",
        "pool_size": 5,
        "max_overflow": 10
    },
    "celery": {
        "broker_url": "redis://localhost:6379/0",
        "result_backend": "redis://localhost:6379/1",
        "task_serializer": "json",
        "result_serializer": "json",
        "accept_content": ["json"]
    }
} 